{
  "uid": "mvp-document-pipeline",
  "title": "Document Pipeline",
  "tags": [
    "mvp",
    "documents"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Progetto Compose",
        "description": "Checkout da cui provengono i log (label project di Alloy). All li include tutti.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "project",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Dove si fermano",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "bargauge",
      "title": "Imbuto della pipeline documentale",
      "gridPos": {
        "w": 16,
        "h": 9,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_sub_documents)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "1 · Rilevati",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(mvp_sub_documents_review{review_status=~\"auto_validated|manually_validated|needs_review|quarantined\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "2 · Con esito di revisione",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(mvp_sub_documents_review{review_status=~\"auto_validated|manually_validated\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "3 · Validati",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum(mvp_sub_documents_send{send_status=\"sent\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "4 · Scaricati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ogni barra è un passo della pipeline, in ordine: la differenza fra due barre consecutive è la dispersione di quel passo. Le barre partono da zero e sono proporzionali, che è ciò che rende leggibile un imbuto."
    },
    {
      "type": "stat",
      "title": "Oltre timeout",
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_documents_stuck_processing)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "bloccati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti in elaborazione oltre MVP_PROCESSING_TIMEOUT_SECONDS. Su questo scatta DocumentStuckInProcessing. Alert correlati: DocumentStuckInProcessing, StepFunctionExecutionFailed, QueueBacklogHigh — runbook docs/runbooks/document-pipeline.md"
    },
    {
      "type": "row",
      "title": "Stato corrente",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "stat",
      "title": "Completati",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"completed\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "completati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti la cui elaborazione è arrivata in fondo."
    },
    {
      "type": "stat",
      "title": "In elaborazione",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 6,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"processing\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in corso",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Presi in carico dalla pipeline e non ancora conclusi."
    },
    {
      "type": "stat",
      "title": "In attesa",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"pending\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in attesa",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Caricati ma non ancora presi in carico."
    },
    {
      "type": "stat",
      "title": "Falliti",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 18,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"failed\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Elaborazione interrotta. Il documento resta caricato: l'errore è di estrazione, non di ingestione."
    },
    {
      "type": "row",
      "title": "Esiti della revisione",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "table",
      "title": "Sotto-documenti per esito di revisione",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (review_status) (mvp_sub_documents_review)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "sotto-documenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "review_status": "Esito",
              "Value": "Sotto-documenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Partizione completa dei sotto-documenti: la somma delle righe è il totale rilevato."
    },
    {
      "type": "table",
      "title": "Sotto-documenti per stato di invio",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (send_status) (mvp_sub_documents_send)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "sotto-documenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "send_status": "Stato",
              "Value": "Sotto-documenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "`sent` significa che il PDF è stato scaricato: il recapito avviene fuori piattaforma, quindi il download è l'ultimo evento osservabile."
    },
    {
      "type": "table",
      "title": "Fallimenti Step Functions per motivo",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (mvp_stepfunctions_executions_failed_total{state_machine=~\".*document-pipeline\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "fallimenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "Motivo",
              "Value": "Fallimenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "`start_failure` è un avvio rifiutato da Step Functions; `task_failure` è un task interrotto durante l'esecuzione."
    },
    {
      "type": "row",
      "title": "Flusso",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput step pipeline (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_received_total{task_type!~\"communication.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}} ricevuti"
        },
        {
          "refId": "B",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_failed_total{task_type!~\"communication.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}} falliti"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Solo i task documentali: il filtro esclude quelli della pipeline comunicazioni, che hanno una dashboard propria."
    },
    {
      "type": "timeseries",
      "title": "Esecuzioni Step Functions (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_stepfunctions_executions_started_total{state_machine=~\".*document-pipeline\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "avviate"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mvp_stepfunctions_executions_failed_total{state_machine=~\".*document-pipeline\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "fallite"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Log",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "logs",
      "title": "Errori pipeline (worker documenti + app)",
      "gridPos": {
        "w": 24,
        "h": 11,
        "x": 0,
        "y": 35
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=~\"queue|app\"} |~ \"(?i)level_name.{0,6}(error|critical|emergency)\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Monolog scrive JSON con level_name; i container di infrastruttura usano logfmt con level=. Il filtro copre entrambi."
    }
  ]
}

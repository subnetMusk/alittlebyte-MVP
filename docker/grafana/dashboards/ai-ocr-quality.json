{
  "uid": "mvp-ai-ocr-quality",
  "title": "AI and OCR Quality",
  "tags": [
    "mvp",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Progetto Compose",
        "description": "Checkout da cui provengono i log (label project di Alloy). All li include tutti.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "project",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Qualità OCR (Textract)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Confidenza media OCR",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_textract_confidence_sum[$__range])) / (sum(rate(mvp_textract_confidence_count[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "confidenza"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Media sulla finestra selezionata, non da inizio processo: risponde al selettore temporale. Vuota quando nella finestra non ci sono stati job OCR — l'assenza di misura è l'informazione corretta."
    },
    {
      "type": "stat",
      "title": "Durata media OCR",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_textract_duration_seconds_sum[$__range])) / (sum(rate(mvp_textract_duration_seconds_count[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "durata"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Stessa finestra della confidenza. Il timeout di un job è TEXTRACT_TIMEOUT_SECONDS."
    },
    {
      "type": "stat",
      "title": "Job OCR falliti",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_textract_jobs_failed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Job rifiutati da Textract con un errore AWS. Non include i documenti la cui estrazione è fallita a valle."
    },
    {
      "type": "stat",
      "title": "Estrazioni fallite",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_sub_documents_failed)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "fallite",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sotto-documenti che portano un messaggio di errore: il guasto è successivo all'OCR."
    },
    {
      "type": "table",
      "title": "Textract — esiti job",
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_textract_jobs_started_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "avviati",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum(mvp_textract_jobs_completed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "completati",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum(mvp_textract_jobs_failed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum(mvp_textract_jobs_skipped_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "saltati",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Avviati",
              "Value #B": "Completati",
              "Value #C": "Falliti",
              "Value #D": "Saltati"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "La differenza fra avviati e completati+falliti sono i job ancora in corso al momento dello scrape."
    },
    {
      "type": "table",
      "title": "Textract — fallimenti per codice errore",
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error) (mvp_textract_jobs_failed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "fallimenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "error": "Codice AWS",
              "Value": "Fallimenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Codice di errore restituito dall'SDK. Non enumerabile a priori: la serie compare solo dopo il primo errore di quel tipo."
    },
    {
      "type": "table",
      "title": "Textract — job saltati per motivo",
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (mvp_textract_jobs_skipped_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "saltati",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "Motivo",
              "Value": "Saltati"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "`disabled` significa che Textract è spento da configurazione: la pipeline prosegue senza OCR."
    },
    {
      "type": "timeseries",
      "title": "Job Textract (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_textract_jobs_started_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "avviati"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mvp_textract_jobs_completed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "completati"
        },
        {
          "refId": "C",
          "expr": "sum(rate(mvp_textract_jobs_failed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Output AI rifiutati dal validatore (rate 15m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(mvp_ai_outputs_invalid_total[15m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{operation}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Risposte del modello che non superano la validazione di schema. Una crescita segnala una regressione del prompt o del modello, prima che si veda sui documenti."
    },
    {
      "type": "table",
      "title": "Estrazioni AI per esito revisione",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (review_status) (mvp_ai_extractions_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "estrazioni",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "review_status": "Esito",
              "Value": "Estrazioni"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Esito assegnato al momento dell'estrazione, confrontando la confidenza con MVP_CONFIDENCE_THRESHOLD."
    },
    {
      "type": "table",
      "title": "Sotto-documenti per stato di revisione",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (review_status) (mvp_sub_documents_review)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "sotto-documenti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "review_status": "Stato",
              "Value": "Sotto-documenti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Stato corrente, non al momento dell'estrazione: un documento validato a mano si sposta qui ma non nella tabella accanto."
    },
    {
      "type": "timeseries",
      "title": "Sotto-documenti totali",
      "gridPos": {
        "w": 24,
        "h": 7,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_sub_documents)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "totali"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Volume complessivo su cui si calcolano le quote di questa pagina."
    },
    {
      "type": "row",
      "title": "Log",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 36
      }
    },
    {
      "type": "logs",
      "title": "Errori Textract / Bedrock (worker documenti)",
      "gridPos": {
        "w": 24,
        "h": 11,
        "x": 0,
        "y": 37
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=\"queue\"} |~ \"(?i)level_name.{0,6}(error|critical)\" |~ \"(?i)textract|bedrock|extract|ocr|workflow\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "row",
      "title": "OCR locale (profilo local)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 48
      }
    },
    {
      "type": "timeseries",
      "title": "Pagine lette dall'OCR locale (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(mvp_local_ocr_pages_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{method}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Solo con MVP_EXECUTION_PROFILE=local. text_layer: testo letto dal PDF, senza riconoscimento; tesseract: pagina scansionata riconosciuta in locale."
    },
    {
      "type": "stat",
      "title": "Durata media OCR locale",
      "gridPos": {
        "w": 6,
        "h": 8,
        "x": 12,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_local_ocr_duration_seconds_sum[$__range])) / (sum(rate(mvp_local_ocr_duration_seconds_count[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "durata"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Media per documento sulla finestra selezionata. Vuota senza OCR locale nella finestra."
    },
    {
      "type": "stat",
      "title": "OCR locale falliti",
      "gridPos": {
        "w": 6,
        "h": 8,
        "x": 18,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_local_ocr_jobs_failed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti per cui l'OCR locale non è riuscito: strumenti assenti nell'immagine, PDF illeggibile o timeout."
    }
  ]
}

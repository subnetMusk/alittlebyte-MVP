{
  "uid": "mvp-logs-errors",
  "title": "Logs and Errors",
  "tags": [
    "mvp",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Progetto Compose",
        "description": "Checkout da cui provengono i log (label project di Alloy). All li include tutti.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "project",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cosa sta succedendo ora",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Errori ultimi 5 minuti",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\" [5m]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "errori",
          "instant": true
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Finestra fissa, indipendente dal selettore temporale: dice se il problema è in corso adesso."
    },
    {
      "type": "stat",
      "title": "Errori nell'intervallo",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "errori",
          "instant": true
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Segue il selettore temporale: il totale del periodo che stai guardando."
    },
    {
      "type": "stat",
      "title": "Servizio più rumoroso",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, sum by (service) (count_over_time({project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\" [$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Dove concentrare l'attenzione: la legenda porta il nome del servizio, il valore il conteggio."
    },
    {
      "type": "stat",
      "title": "Alert attivi",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "firing",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Regole Prometheus in firing: collega le righe di log alle sedici regole in docker/prometheus/rules/."
    },
    {
      "type": "timeseries",
      "title": "Tasso errori per servizio (rate 5m)",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\" [5m]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "A piena larghezza perché lo scopo è confrontare i servizi sulla stessa scala temporale. Non impilato: le serie vanno lette una per una."
    },
    {
      "type": "row",
      "title": "Distribuzione e righe",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "logs",
      "title": "Tutti gli errori dello stack",
      "gridPos": {
        "w": 16,
        "h": 10,
        "x": 0,
        "y": 15
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Ordinati dal più recente. Il filtro copre sia il JSON di Monolog sia il logfmt dei container di infrastruttura."
    },
    {
      "type": "table",
      "title": "Conteggio errori per servizio",
      "gridPos": {
        "w": 8,
        "h": 10,
        "x": 16,
        "y": 15
      },
      "description": "Sul periodo selezionato. I servizi assenti non hanno prodotto errori in quella finestra.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({project=~\"$project\"} |~ \"(?i)(level_name.{0,6}(error|critical|emergency)|level=(error|critical|fatal))\" != \"No such container\" [$__range]))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "Servizio",
              "Value": "Errori"
            }
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "row",
      "title": "Per servizio",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "logs",
      "title": "Applicazione (app)",
      "gridPos": {
        "w": 8,
        "h": 11,
        "x": 0,
        "y": 26
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=\"app\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Non filtrato per livello: qui si segue il flusso completo di un'operazione, non solo gli errori."
    },
    {
      "type": "logs",
      "title": "Worker documenti (queue)",
      "gridPos": {
        "w": 8,
        "h": 11,
        "x": 8,
        "y": 26
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=\"queue\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "Worker comunicazioni (queue-communications)",
      "gridPos": {
        "w": 8,
        "h": 11,
        "x": 16,
        "y": 26
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=\"queue-communications\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "La seconda metà della pipeline: prima i suoi log non comparivano in nessuna vista per-servizio."
    }
  ]
}

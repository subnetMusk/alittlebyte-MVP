{
  "uid": "mvp-api-golden-signals",
  "title": "API Golden Signals",
  "tags": [
    "mvp",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Stato del servizio",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Stato API",
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(mvp_http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "errori",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Verde sotto l'1% di 5xx, giallo fino al 5%, rosso oltre: la stessa soglia su cui scatta APIHighErrorRate. Vuoto quando non c'è traffico, che non è un errore."
    },
    {
      "type": "stat",
      "title": "Alert attivi",
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "firing",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Regole Prometheus attualmente in firing, su tutte le pipeline. È il collegamento fra questa pagina e le 16 regole in docker/prometheus/rules/."
    },
    {
      "type": "stat",
      "title": "Errori nell'ultima ora",
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mvp_http_requests_total{status=~\"5..\"}[1h])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "5xx",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Conteggio assoluto, non tasso: dice se è già successo qualcosa anche quando il rapporto istantaneo è tornato a posto."
    },
    {
      "type": "row",
      "title": "Segnali d'oro",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Traffico",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "req/s",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rate delle richieste servite, tutte le route."
    },
    {
      "type": "stat",
      "title": "Tasso di errore (5xx)",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(mvp_http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "quota",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Senza clamp sul denominatore: a traffico zero il risultato è vuoto, non zero, così il rapporto non viene schiacciato proprio quando le richieste calano."
    },
    {
      "type": "stat",
      "title": "Latenza p95",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(mvp_http_request_duration_seconds_bucket[5m])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Soglia di allerta a 1s (APIHighLatencyP95)."
    },
    {
      "type": "stat",
      "title": "Latenza p99",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(mvp_http_request_duration_seconds_bucket[5m])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p99",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Richieste per classe di stato (rate 5m)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_http_requests_total{status=~\"2..\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mvp_http_requests_total{status=~\"4..\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "4xx"
        },
        {
          "refId": "C",
          "expr": "sum(rate(mvp_http_requests_total{status=~\"5..\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "5xx"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non impilate: solo il segmento inferiore sarebbe leggibile con precisione."
    },
    {
      "type": "timeseries",
      "title": "Latenza (quantili)",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(mvp_http_request_duration_seconds_bucket[5m])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(mvp_http_request_duration_seconds_bucket[5m])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(mvp_http_request_duration_seconds_bucket[5m])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Dettaglio e saturazione",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "table",
      "title": "Endpoint — golden signals per route",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(mvp_http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "traffico",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (route) (rate(mvp_http_requests_total{status=~\"5..\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "errori",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(mvp_http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "route": "Route",
              "Value #A": "Traffico",
              "Value #B": "Errori 5xx",
              "Value #C": "p95"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Terzo livello: serve per l'indagine, non per accorgersi di un problema. `route` è il nome della route Laravel; quelle senza nome ricadono su `unmatched`."
    },
    {
      "type": "timeseries",
      "title": "Connessioni aperte (edge)",
      "gridPos": {
        "w": 4,
        "h": 8,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(traefik_open_connections) by (entrypoint)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{entrypoint}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Saturazione del bordo: connessioni tenute aperte da Traefik."
    },
    {
      "type": "timeseries",
      "title": "Backlog pipeline",
      "gridPos": {
        "w": 4,
        "h": 8,
        "x": 16,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_original_documents{status=\"processing\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in elaborazione"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Documenti fermi in elaborazione: saturazione a valle dell'API."
    },
    {
      "type": "timeseries",
      "title": "Memoria Collector",
      "gridPos": {
        "w": 4,
        "h": 8,
        "x": 20,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_process_memory_rss",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "RSS"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Se il Collector satura, tutte le metriche di questa pagina smettono di arrivare."
    }
  ]
}

{
  "uid": "mvp-queues-and-dlq",
  "title": "Queues and DLQ",
  "tags": [
    "mvp",
    "queues"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Progetto Compose",
        "description": "Checkout da cui provengono i log (label project di Alloy). All li include tutti.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "project",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Utilization — quanto lavoro scorre",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Messaggi consumati (rate 5m)",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_received_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Entrambe le pipeline: questa è la vista cross-pipeline del trasporto."
    },
    {
      "type": "timeseries",
      "title": "Workflow completati (rate 5m)",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_document_workflow_completed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "documenti"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mvp_communication_workflow_completed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "comunicazioni"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Il lavoro che arriva davvero in fondo, non solo quello consumato dalla coda."
    },
    {
      "type": "timeseries",
      "title": "Esecuzioni Step Functions avviate (rate 5m)",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state_machine) (rate(mvp_stepfunctions_executions_started_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{state_machine}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Quante esecuzioni partono per state machine: è il lavoro che entra nel sistema, da confrontare con i workflow che ne escono completati."
    },
    {
      "type": "row",
      "title": "Saturation — quanto lavoro attende",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "stat",
      "title": "Messaggi in DLQ",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_dlq_messages)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "in DLQ",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Profondità reale letta da SQS a ogni scrape. Se il probe fallisce la serie sparisce invece di valere zero: uno zero inventato spegnerebbe in silenzio un alert critical."
    },
    {
      "type": "stat",
      "title": "Task in attesa",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 6,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_workflow_tasks{status=\"pending\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "pending",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Task presi in carico dal runner ma non ancora eseguiti. È la saturazione vera del trasporto: la DLQ conta solo ciò che ha già smesso di essere ritentato."
    },
    {
      "type": "stat",
      "title": "Task in esecuzione",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_workflow_tasks{status=\"running\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "running",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Task con un claim attivo. Un valore che non scende indica worker morti con claim non rilasciati: il runner li recupera dopo MVP_WORKFLOW_RUNNING_CLAIM_TTL_SECONDS."
    },
    {
      "type": "stat",
      "title": "Bloccati oltre timeout",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 18,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mvp_documents_stuck_processing) + sum(mvp_communications_stuck_processing)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "bloccati",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Somma delle due pipeline: soggetti fermi oltre il proprio timeout di elaborazione."
    },
    {
      "type": "table",
      "title": "DLQ per pipeline",
      "gridPos": {
        "w": 8,
        "h": 6,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (mvp_dlq_messages)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "messaggi",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "queue": "Pipeline",
              "Value": "Messaggi"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Quale delle due code morte contiene lavoro. Assente per una pipeline il cui URL DLQ non è configurato."
    },
    {
      "type": "stat",
      "title": "Probe DLQ",
      "gridPos": {
        "w": 8,
        "h": 6,
        "x": 8,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Non disponibile",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Attivo",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(mvp_dlq_probe_up)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "probe",
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Quando è 0 la profondità DLQ non è misurabile e DLQNotEmpty non è affidabile: è ciò che segnala DlqProbeDown."
    },
    {
      "type": "table",
      "title": "Task per stato",
      "gridPos": {
        "w": 8,
        "h": 6,
        "x": 16,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (mvp_workflow_tasks)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "task",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "status": "Stato",
              "Value": "Task"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Partizione completa dei task registrati: pending, running, succeeded, skipped, failed."
    },
    {
      "type": "row",
      "title": "Errors — cosa si rompe",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "timeseries",
      "title": "Messaggi falliti (rate 5m)",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (rate(mvp_sqs_messages_failed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task_type}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Heartbeat Step Functions (rate 5m)",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mvp_stepfunctions_heartbeats_sent_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "inviati"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mvp_stepfunctions_heartbeats_failed_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "falliti"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Indicatore anticipatore: un heartbeat che fallisce porta a TaskTimedOut, cioè a un messaggio in DLQ. Si vede la causa prima dell'effetto."
    },
    {
      "type": "table",
      "title": "Callback rifiutati",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, error) (mvp_stepfunctions_callbacks_failed_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "rifiuti",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "operation": "Operazione",
              "error": "Errore",
              "Value": "Rifiuti"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "TaskTimedOut, TaskDoesNotExist e InvalidToken sono permanenti: il runner non ritenta, il lavoro di business è già a database."
    },
    {
      "type": "table",
      "title": "Messaggi duplicati per task",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (mvp_sqs_messages_duplicate_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "duplicati",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "task_type": "Task",
              "Value": "Duplicati"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Un duplicato indica un visibility timeout più corto della durata reale del task: il messaggio torna disponibile mentre è ancora in lavorazione."
    },
    {
      "type": "table",
      "title": "Readiness dipendenze",
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "KO",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (check) (mvp_readiness_status)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "stato",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "check": "Dipendenza",
              "Value": "Stato"
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Dipendenze di processo verificate a ogni scrape. Non copre S3, Bedrock e Textract: sarebbero chiamate a pagamento ogni 15 secondi."
    },
    {
      "type": "row",
      "title": "Log",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 37
      }
    },
    {
      "type": "logs",
      "title": "Log worker (entrambe le pipeline)",
      "gridPos": {
        "w": 24,
        "h": 10,
        "x": 0,
        "y": 38
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=~\"$project\", service=~\"queue|queue-communications\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Non filtrato per livello: qui si guarda il flusso, gli errori hanno la dashboard Logs and Errors."
    }
  ]
}
